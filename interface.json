                "settings_gate_required": true,
                "debug_recording": false,
                "duration_seconds": 600,
                "dpi": 240,
                "game_fps": 60,
                "render_quality": "standard",
                "note_speed": 2.0,
                "wait_for_completion": true,
                "completion_missing_frames": 120,
                "require_completion": true,
                "save_result_frame": true,
