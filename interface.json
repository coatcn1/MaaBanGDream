{
  "$schema": "https://raw.githubusercontent.com/MaaXYZ/MaaFramework/main/tools/interface.schema.json",
  "interface_version": 2,
  "name": "MaaBanGDream",
  "label": "BanG Dream! 自动化（MaaFramework）",
  "version": "0.8.1",
  "description": "支持自动演出、机器人实时演奏、智能校准和挑战演出。",
  "license": "GPL-3.0-only",
  "controller": [
    {
      "name": "Android",
      "label": "Android 模拟器（1280×720）",
      "type": "Adb",
      "display_short_side": 720
    }
  ],
  "resource": [
    {
      "name": "Bilibili",
      "label": "哔哩哔哩服",
      "path": [
        "./resource"
      ],
      "controller": [
        "Android"
      ]
    }
  ],
  "agent": {
    "child_exec": "python",
    "child_args": [
      "./agent/server.py"
    ]
  },
  "task": [
    {
      "name": "AutoLive",
      "label": "自动演出",
      "description": "当前曲目或每轮随机选曲，按指定难度连续自动演出。",
      "entry": "AutoLive",
      "option": [
        "AutoLiveSongMode",
        "AutoLiveDifficulty",
        "AutoLiveCount"
      ]
    },
    {
      "name": "RealtimeLive",
      "label": "实时演奏",
      "description": "机器人排练或正式演奏；正式演奏必须先完成相同环境和难度的校准。",
      "entry": "RealtimeMultiLive",
      "option": [
        "RealtimeMode",
        "RealtimeLiveSongMode",
        "RealtimeLiveDifficulty",
        "RealtimeLiveCount",
        "RealtimeLiveDebug"
      ]
    },
    {
      "name": "ContinuousRealtimeLive",
      "label": "一键实时演奏",
      "description": "持续检测演奏页面并自动演奏，不导航、不确认、不读取结算；需在最近 15 分钟内完成一次游戏视觉设置读回复核。",
      "entry": "ContinuousRealtimeLive",
      "option": [
        "ContinuousRealtimeDifficulty",
        "ContinuousRealtimeDebug"
      ]
    },
    {
      "name": "RealtimeCalibration",
      "label": "实时演奏校准",
      "description": "三次排练逐曲调整延迟，再用正式验证并自动启用 Profile。",
      "entry": "RealtimeCalibration",
      "option": [
        "CalibrationDifficulty",
        "CalibrationDebug"
      ]
    },
    {
      "name": "ChallengeLive",
      "label": "挑战演出",
      "description": "使用已校准的实时引擎演奏当前活动挑战曲。",
      "entry": "ChallengeLive",
      "option": [
        "ChallengeDifficulty",
        "ChallengePoints",
        "ChallengeCount",
        "ChallengeDebug"
      ]
    }
  ],
  "option": {
    "AutoLiveSongMode": {
      "type": "select",
      "label": "歌曲选择",
      "default_case": "Current",
      "cases": [
        {
          "name": "Current",
          "label": "当前曲目",
          "pipeline_override": {
            "AutoLiveSongSelectMarker": {
              "next": [
                "AutoLiveDifficulty"
              ]
            }
          }
        },
        {
          "name": "Random",
          "label": "每轮随机选曲",
          "pipeline_override": {
            "AutoLiveSongSelectMarker": {
              "next": [
                "AutoLiveRandomSong"
              ]
            }
          }
        }
      ]
    },
    "AutoLiveDifficulty": {
      "type": "select",
      "label": "难度",
      "default_case": "Easy",
      "cases": [
        {
          "name": "Easy",
          "label": "Easy",
          "pipeline_override": {
            "AutoLiveDifficulty": {
              "target": [
                715,
                545
              ]
            }
          }
        },
        {
          "name": "Normal",
          "label": "Normal",
          "pipeline_override": {
            "AutoLiveDifficulty": {
              "target": [
                827,
                545
              ]
            }
          }
        },
        {
          "name": "Hard",
          "label": "Hard",
          "pipeline_override": {
            "AutoLiveDifficulty": {
              "target": [
                940,
                545
              ]
            }
          }
        },
        {
          "name": "Expert",
          "label": "Expert",
          "pipeline_override": {
            "AutoLiveDifficulty": {
              "target": [
                1051,
                545
              ]
            }
          }
        },
        {
          "name": "Special",
          "label": "Special",
          "pipeline_override": {
            "AutoLiveDifficulty": {
              "target": [
                1180,
                545
              ]
            }
          }
        }
      ]
    },
    "AutoLiveCount": {
      "type": "input",
      "label": "演出次数",
      "inputs": [
        {
          "name": "Count",
          "label": "次数",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]|[1-9][0-9])$",
          "pattern_msg": "请输入 1 到 99 的整数。"
        }
      ],
      "pipeline_override": {
        "AutoLiveRoundGate": {
          "max_hit": "{Count}",
          "custom_action_param": {
            "task_name": "AutoLive",
            "label": "自动演出",
            "total": "{Count}",
            "phase": "start"
          }
        }
      }
    },
    "RealtimeMode": {
      "type": "select",
      "label": "演奏模式",
      "default_case": "Rehearsal",
      "cases": [
        {
          "name": "Rehearsal",
          "label": "机器人排练"
        },
        {
          "name": "Formal",
          "label": "机器人正式演奏",
          "pipeline_override": {
            "RealtimeLiveFormalModeGate": {
              "next": [
                "RealtimeLiveRequireProfile"
              ]
            }
          }
        },
        {
          "name": "VisualEvaluation",
          "label": "视觉设置评估（实验）",
          "pipeline_override": {
            "RealtimeLiveFormalModeGate": {
              "next": [
                "RealtimeLiveVisualEvaluationRequireProfile"
              ]
            },
            "RealtimeLiveFormalReady": {
              "next": [
                "RealtimeLiveVisualEvaluationSettingsGate"
              ]
            }
          }
        }
      ]
    },
    "RealtimeLiveSongMode": {
      "type": "select",
      "label": "歌曲选择",
      "default_case": "Current",
