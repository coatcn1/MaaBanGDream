{
  "AutoLive": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "AutoLiveProcessConflictGuard"
    ],
    "focus": {
      "Node.Action.Starting": {
        "content": "正在启动自动演出任务",
        "display": [
          "log"
        ]
      },
      "Node.Action.Succeeded": {
        "content": "自动演出任务启动检查已开始",
        "display": [
          "log"
        ]
      }
    }
  },
  "AutoLiveProcessConflictGuard": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "ProcessConflictGuard",
    "next": [
      "AutoLiveRecover"
    ],
    "on_error": [
      "AutoLiveFailure"
    ],
    "focus": {
      "Node.Action.Starting": {
        "content": "正在检测其他程序占用",
        "display": [
          "log"
        ]
      },
      "Node.Action.Failed": {
        "content": "❌ 检测到其他程序占用，本次任务已安全停止",
        "display": [
          "log",
          "toast"
        ]
      }
    }
  },
  "AutoLiveRecover": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "CommonRecover",
    "custom_action_param": {
      "home_node": "AutoLiveHomeMarker",
      "modal_cancel_nodes": [
        "QuitConfirmCancel"
      ],
      "click_nodes": [
        "AutoLiveLoginTap",
        "AutoLiveLoginNext",
        "AutoLiveCommonClose",
        "AutoLiveStorySkipConfirmLarge",
        "AutoLiveStorySkipConfirm",
        "AutoLiveStorySkip",
        "AutoLiveStoryMenu"
      ],
      "escape_interval_ms": 1500,
      "escape_timeout_ms": 60000,
      "restart_limit": 2,
      "restart_wait_ms": 5000,
      "startup_grace_ms": 12000,
      "login_start_node": "AutoLiveLoginScreenMarker",
      "login_start_target": [
        640,
        635
      ],
      "login_marker_priority_attempts": 3,
      "escape_after_login_start": true,
      "package": "com.bilibili.star.bili",
      "login_tap_target": [
        640,
        360
      ]
    },
    "next": [
      "AutoLiveRoundGate"
    ],
    "focus": {
      "Node.Action.Failed": {
        "content": "❌ 自动演出启动或主页恢复失败",
        "display": [
          "log"
        ]
      },
      "Node.Action.Starting": {
        "content": "正在检查游戏进程并恢复主页",
        "display": [
          "log"
        ]
      },
      "Node.Action.Succeeded": {
        "content": "已识别主页，登录状态正常",
        "display": [
          "log"
        ]
      }
    },
    "on_error": [
      "AutoLiveFailure"
    ]
  },
  "AutoLiveRoundGate": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "TaskProgress",
    "custom_action_param": {
      "task_name": "AutoLive",
      "label": "自动演出",
      "total": 1,
      "phase": "start"
    },
    "max_hit": 1,
    "next": [
      "AutoLiveHomeLive"
    ]
  },
  "AutoLiveComplete": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "TaskOutcome",
