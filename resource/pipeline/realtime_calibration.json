{
  "RealtimeCalibration": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "RealtimeCalibrationProcessConflictGuard"
    ]
  },
  "RealtimeCalibrationProcessConflictGuard": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "ProcessConflictGuard",
    "next": [
      "CalibrationDifficultySetting"
    ],
    "on_error": [
      "RealtimeCalibrationFailure"
    ],
    "focus": {
      "Node.Action.Starting": {
        "content": "正在检测其他程序占用",
        "display": [
          "log"
        ]
      },
      "Node.Action.Failed": {
        "content": "❌ 检测到其他程序占用，本次任务已安全停止",
        "display": [
          "log",
          "toast"
        ]
      }
    }
  },
  "CalibrationDifficultySetting": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "RealtimeRuntimeOptions",
    "custom_action_param": {
      "difficulty": "Easy"
    },
    "next": [
      "CalibrationDebugSetting"
    ]
  },
  "CalibrationDebugSetting": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "RealtimeRuntimeOptions",
    "custom_action_param": {
      "debug_recording": false
    },
    "next": [
      "RealtimeCalibrationRun"
    ]
  },
  "RealtimeCalibrationRun": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "RealtimeCalibrationRun",
    "custom_action_param": {
      "timing_offset_ms": 0
    },
    "focus": {
      "Node.Action.Succeeded": {
        "content": "✅ 实时演奏校准成功",
        "display": [
          "log",
          "toast"
        ]
      },
      "Node.Action.Failed": {
        "content": "❌ 实时演奏校准失败：校准流程未完成",
        "display": [
          "log"
        ]
      }
    },
    "on_error": [
      "RealtimeCalibrationFailure"
    ]
  },
  "RealtimeCalibrationSingleLive": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "CommonRecover",
    "custom_action_param": {
      "home_node": "RealtimeLiveHomeMarker",
      "click_nodes": [
        "AutoLiveLoginTap",
        "AutoLiveLoginNext",
        "AutoLiveCommonClose",
        "AutoLiveStorySkipConfirmLarge",
        "AutoLiveStorySkipConfirm",
        "AutoLiveStorySkip",
        "AutoLiveStoryMenu"
      ],
      "escape_interval_ms": 1500,
      "escape_timeout_ms": 60000,
      "restart_limit": 2,
      "restart_wait_ms": 5000,
      "startup_grace_ms": 12000,
      "login_start_node": "AutoLiveLoginScreenMarker",
      "login_start_target": [
        640,
        635
      ],
      "login_marker_priority_attempts": 3,
      "escape_after_login_start": true,
      "package": "com.bilibili.star.bili"
    },
    "next": [
      "RealtimeLiveDebugGate"
    ],
    "focus": {
      "Node.Action.Failed": {
        "content": "❌ 校准演出启动或主页恢复失败",
        "display": [
          "log"
        ]
      }
    }
  },
  "CalibrationCaptureSong": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "CalibrationSongIdentity",
    "next": [
      "RealtimeLiveDifficulty"
    ]
  },
  "RealtimeCalibrationRoundComplete": {
    "recognition": "DirectHit",
    "action": "DoNothing"
  },
  "RealtimeCalibrationFailure": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "TaskOutcome",
    "custom_action_param": {
      "task_name": "RealtimeCalibration",
      "label": "实时演奏校准",
      "status": "failure",
      "reason": "实时演奏校准失败：校准流程未完成"
    },
    "focus": {
      "Node.Action.Failed": {
        "content": "❌ 实时演奏校准失败：校准流程未完成",
        "display": [
          "log"
        ]
      }
    }
  }
}
