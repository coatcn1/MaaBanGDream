    "action": "Custom",
    "custom_action": "LiveSelectFind",
    "custom_action_param": {
      "expected": "自由演出",
      "template_node": "ChallengeFreeLiveTemplate",
      "roi": [
        0,
        100,
        1280,
        620
      ],
      "click": false,
      "missing_reason": "无法确认“选择演出”页面",
      "timeout_ms": 10000,
      "interval_ms": 500
    },
    "next": [
      "ChallengeEntry"
    ],
    "focus": {
      "Node.Action.Failed": {
        "content": "❌ 无法确认“选择演出”页面",
        "display": [
          "log"
        ]
      },
      "Node.Action.Starting": {
        "content": "正在识别选择演出界面（兼容有活动和无活动）",
        "display": [
          "log"
        ]
      },
      "Node.Action.Succeeded": {
        "content": "已识别选择演出界面",
        "display": [
          "log"
        ]
      }
    },
    "on_error": [
      "ChallengeEnsureHome"
    ]
  },
  "ChallengeEntryTemplate": {
    "recognition": "TemplateMatch",
    "template": "challenge_live.png",
    "threshold": 0.88,
    "action": "DoNothing"
  },
  "ChallengeNoEvent": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "TaskOutcome",
    "custom_action_param": {
      "task_name": "ChallengeLive",
      "label": "挑战演出",
      "status": "failure",
      "reason": "当前没有可用的挑战演出活动"
    },
    "focus": {
      "Node.Action.Failed": {
        "content": "❌ 当前没有可用的挑战演出活动",
        "display": [
          "log"
        ]
      }
    }
  },
  "ChallengeRoundCompleted": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "TaskProgress",
    "custom_action_param": {
      "task_name": "ChallengeLive",
      "label": "挑战演出",
      "phase": "completed"
    },
    "next": [
      "ChallengeRoundGate",
      "ChallengeComplete"
    ],
    "focus": {
      "Node.Action.Failed": {
        "content": "❌ 挑战演出进度记录失败",
        "display": [
          "log"
        ]
      }
    }
  }
}
