{
  "ContinuousRealtimeLive": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "ContinuousRealtimeProcessConflictGuard"
    ]
  },
  "ContinuousRealtimeProcessConflictGuard": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "ProcessConflictGuard",
    "next": [
      "ContinuousRealtimeDifficultyConfigure"
    ],
    "on_error": [
      "ContinuousRealtimeFailure"
    ]
  },
  "ContinuousRealtimeDifficultyConfigure": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "ContinuousRealtimeLiveConfigure",
    "custom_action_param": {
      "reset": true,
      "difficulty": "Easy"
    },
    "next": [
      "ContinuousRealtimeDebugConfigure"
    ],
    "on_error": [
      "ContinuousRealtimeFailure"
    ]
  },
  "ContinuousRealtimeDebugConfigure": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "ContinuousRealtimeLiveConfigure",
    "custom_action_param": {
      "debug_recording": false,
      "diagnostic_trace": true
    },
    "next": [
      "ContinuousRealtimeWatcher"
    ],
    "on_error": [
      "ContinuousRealtimeFailure"
    ]
  },
  "ContinuousRealtimeWatcher": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "ContinuousRealtimeLive",
    "focus": {
      "Node.Action.Starting": {
        "content": "🔎 一键实时演奏已开始识别：请按任务所选难度进入演出，识别到开场封面与标题后将自动演奏；演出后会读取 PGGBM 并返回主页",
        "display": [
          "log",
          "toast"
        ]
      }
    },
    "next": [
      "ContinuousRealtimeComplete"
    ],
    "on_error": [
      "ContinuousRealtimeFailure"
    ]
  },
  "ContinuousRealtimeComplete": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "TaskOutcome",
    "custom_action_param": {
      "task_name": "ContinuousRealtimeLive",
      "label": "一键实时演奏",
      "status": "success"
    },
    "focus": {
      "Node.Action.Succeeded": {
        "content": "✅ 已完成一键实时演奏、读取 PGGBM 并返回主页",
        "display": [
          "log",
          "toast"
        ]
      }
    }
  },
  "ContinuousRealtimeFailure": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "TaskOutcome",
    "custom_action_param": {
      "task_name": "ContinuousRealtimeLive",
      "label": "一键实时演奏",
      "status": "failure",
      "reason": "一键实时演奏流程未完成",
      "reason_source": "latest"
    }
  }
}
