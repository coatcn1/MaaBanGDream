{
  "ContinuousRealtimeLive": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "next": [
      "ContinuousRealtimeProcessConflictGuard"
    ]
  },
  "ContinuousRealtimeProcessConflictGuard": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "ProcessConflictGuard",
    "next": [
      "ContinuousRealtimeWatcher"
    ],
    "on_error": [
      "ContinuousRealtimeFailure"
    ]
  },
  "ContinuousRealtimeWatcher": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "ContinuousRealtimeLive",
    "custom_action_param": {
      "difficulty": "Easy",
      "dpi": 240,
      "game_fps": 60,
      "render_quality": "standard",
      "debug_recording": false
    },
    "on_error": [
      "ContinuousRealtimeFailure"
    ]
  },
  "ContinuousRealtimeFailure": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "TaskOutcome",
    "custom_action_param": {
      "task_name": "ContinuousRealtimeLive",
      "label": "一键实时演奏",
      "status": "failure",
      "reason": "一键实时演奏流程未完成",
      "reason_source": "latest"
    },
    "focus": {
      "Node.Action.Starting": {
        "content": "❌ 一键实时演奏未完成，请查看实时演奏错误原因",
        "display": [
          "log",
          "toast"
        ]
      }
    }
  }
}
