{
  "StartGame": {
    "recognition": "DirectHit",
    "action": "StartApp",
    "package": "com.bilibili.star.bili",
    "next": [
      "HomeMarker",
      "LoginTapToStart",
      "LoginNext",
      "CommonClose"
    ],
    "on_error": [
      "CommonRecover"
    ]
  },
  "HomeMarker": {
    "recognition": "TemplateMatch",
    "template": "home_marker.png",
    "threshold": 0.82,
    "action": "DoNothing"
  },
  "LoginTapToStart": {
    "recognition": "TemplateMatch",
    "template": "login_tap_to_start.png",
    "threshold": 0.9,
    "action": "Custom",
    "custom_action": "ForegroundClick",
    "next": [
      "HomeMarker",
      "LoginNext",
      "CommonClose",
      "LoginTapToStart"
    ],
    "on_error": [
      "CommonRecover"
    ],
    "focus": {
      "Node.Action.Failed": {
        "content": "❌ 点击失败：游戏不在前台、控制器拒绝输入或页面位置已变化",
        "display": [
          "log"
        ]
      }
    }
  },
  "LoginNext": {
    "recognition": "TemplateMatch",
    "template": "login_next.png",
    "threshold": 0.9,
    "action": "Custom",
    "custom_action": "ForegroundClick",
    "next": [
      "HomeMarker",
      "LoginNext",
      "CommonClose"
    ],
    "on_error": [
      "CommonRecover"
    ],
    "focus": {
      "Node.Action.Failed": {
        "content": "❌ 点击失败：游戏不在前台、控制器拒绝输入或页面位置已变化",
        "display": [
          "log"
        ]
      }
    }
  },
  "CommonClose": {
    "recognition": "TemplateMatch",
    "template": "common_close.png",
    "threshold": 0.9,
    "action": "Custom",
    "custom_action": "ForegroundClick",
    "next": [
      "HomeMarker",
      "LoginNext",
      "CommonClose"
    ],
    "on_error": [
      "CommonRecover"
    ],
    "focus": {
      "Node.Action.Failed": {
        "content": "❌ 点击失败：游戏不在前台、控制器拒绝输入或页面位置已变化",
        "display": [
          "log"
        ]
      }
    }
  },
  "CommonRecover": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "CommonRecover",
    "custom_action_param": {
      "home_node": "HomeMarker",
      "escape_interval_ms": 1500,
      "escape_timeout_ms": 60000,
      "restart_limit": 2,
      "restart_wait_ms": 5000,
      "click_nodes": [
        "LoginTapToStart",
        "LoginNext",
        "CommonClose"
      ],
      "package": "com.bilibili.star.bili"
    },
    "next": [
      "HomeMarker"
    ],
    "focus": {
      "Node.Action.Failed": {
        "content": "❌ 60 秒内未恢复到主页：可能仍在登录、弹窗未识别或游戏无响应",
        "display": [
          "log"
        ]
      }
    }
  },
  "CommonRefreshScreen": {
    "recognition": "DirectHit",
    "action": "DoNothing"
  },
  "TaskReportVisible": {
    "recognition": "DirectHit",
    "action": "DoNothing"
  }
}
