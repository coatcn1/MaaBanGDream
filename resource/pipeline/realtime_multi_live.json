{
  "RealtimeMultiLive": {
    "recognition": "DirectHit",
    "action": "StartApp",
    "package": "com.bilibili.star.bili",
    "next": ["RealtimeLiveRoundGate"]
  },
  "RealtimeLiveRoundGate": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "max_hit": 1,
    "next": ["RealtimeLiveDebugGate"]
  },
  "RealtimeLiveComplete": {
    "recognition": "DirectHit",
    "action": "DoNothing"
  },
  "RealtimeLiveEnsureHome": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "CommonRecover",
    "custom_action_param": {
      "home_node": "RealtimeLiveHomeMarker",
      "click_nodes": [
        "AutoLiveLoginTap", "AutoLiveLoginNext", "AutoLiveCommonClose",
        "AutoLiveStorySkipConfirmLarge", "AutoLiveStorySkipConfirm",
        "AutoLiveStorySkip", "AutoLiveStoryMenu"
      ],
      "escape_interval_ms": 1500,
      "escape_timeout_ms": 60000,
      "restart_limit": 2,
      "restart_wait_ms": 5000,
      "startup_grace_ms": 12000,
      "login_start_node": "AutoLiveLoginScreenMarker",
      "login_start_target": [640, 635],
      "escape_after_login_start": true,
      "package": "com.bilibili.star.bili"
    },
    "next": ["RealtimeLiveHomeMarker"]
  },
  "RealtimeLiveHomeMarker": {
    "recognition": "TemplateMatch",
    "template": "home_marker.png",
    "threshold": 0.88,
    "action": "DoNothing",
    "next": ["RealtimeLiveHomeLive"],
    "on_error": ["RealtimeLiveEnsureHome"]
  },
  "RealtimeLiveHomeLive": {
    "recognition": "TemplateMatch",
    "template": "home_live.png",
    "threshold": 0.88,
    "action": "Custom",
    "custom_action": "ForegroundClick",
    "target": [1085, 580, 180, 130],
    "next": ["RealtimeLiveHomeMarker", "RealtimeLiveFreeLive", "RealtimeLiveNavigationClose"],
    "on_error": ["RealtimeLiveEnsureHome"]
  },
  "RealtimeLiveNavigationClose": {
    "recognition": "TemplateMatch",
